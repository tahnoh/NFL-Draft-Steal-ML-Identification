            </column>
            <column caption='40-yard Dash: Z-score' datatype='real' name='[Calculation_2030159611437062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(WINDOW_AVG(AVG([40-yd Dash])) - AVG([40-yd Dash]))&#10;/&#10;WINDOW_STDEV(AVG([40-yd Dash]))'>
