                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Bench Press: Z-score' datatype='real' name='[Calculation_2030159612452873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Bench Press]) - WINDOW_AVG(AVG([Bench Press])))&#10;/&#10;WINDOW_STDEV(AVG([Bench Press]))'>
