      <column caption='Draft_Tier' datatype='string' name='[Calculation_2030159272284161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Round]) THEN &quot;Undrafted&quot;&#10;ELSEIF [Round] &lt;= 3 THEN &quot;Rounds 1–3&quot;&#10;ELSE &quot;Rounds 4–7&quot;&#10;END' />
